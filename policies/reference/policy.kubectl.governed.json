{
  "schema_version": "helm.integration.policy.reference.v1",
  "profile": "policy_kubectl_governed_demo",
  "sample_only": true,
  "rules": [
    {
      "match": { "command_class": "read_only" },
      "verdict": "ALLOW",
      "reason_code": "KUBECTL_READ_ONLY_ALLOW"
    },
    {
      "match": { "command_class": "mutating" },
      "verdict": "ESCALATE",
      "reason_code": "KUBECTL_MUTATION_APPROVAL_REQUIRED"
    },
    {
      "match": { "command_class": "exec_channel" },
      "verdict": "ESCALATE",
      "reason_code": "KUBECTL_EXEC_CHANNEL_APPROVAL_REQUIRED"
    },
    {
      "match": { "command_class": "destructive" },
      "verdict": "DENY",
      "reason_code": "KUBECTL_DESTRUCTIVE_DENY"
    }
  ]
}
