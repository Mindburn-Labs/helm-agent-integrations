{
  "name": "@helm-ai/opencode-governance",
  "version": "0.1.0",
  "description": "Fail-closed HELM governance plugin for opencode: kernel verdicts mapped onto permission.ask, boundary evidence taps on tool.execute.before/after",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
