    "test": "npm run build && node --test \"dist/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "helm",
    "opencode",
    "governance",
    "fail-closed",
    "receipts",
    "boundary-records"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
