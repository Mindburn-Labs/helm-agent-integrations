{
  "description": "Target binding vectors both languages run. episodes: the bound targets of a fixture episode from episode.cases.json. calls: what bind_target sends for a model's call, or the bound target its refusal names (text, when present, is the exact refusal). schemas: the input schema bound_input_schema lists to the model.",
  "episodes": [
    {
      "name": "an ordinary episode binds its own work and organization",
      "episode": "full",
      "targets": {
        "helm_work_get": "work:0b7e3c1a-55d2-4c6f-8a90-3e4f5a6b7c02",
        "helm_work_report": "work:0b7e3c1a-55d2-4c6f-8a90-3e4f5a6b7c02",
        "helm_work_request_input": "work:0b7e3c1a-55d2-4c6f-8a90-3e4f5a6b7c02",
        "helm_org_request_capability": "org:org-7a1"
      }
    },
    {
      "name": "an episode without an organization binds only its own work",
      "episode": "minimal",
      "targets": {
        "helm_work_get": "work:w-min",
        "helm_work_report": "work:w-min",
        "helm_work_request_input": "work:w-min"
      }
    },
    {
      "name": "an evaluation episode also binds the original work it reviews",
      "episode": "evaluation",
      "targets": {
        "helm_work_get": "work:450c7298-ff7e-4a1b-9c3d-5e6f7a8b9c0d",
