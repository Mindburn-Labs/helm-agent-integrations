  "schemas": [
    {
      "name": "a bound tool's target is optional and described as bound",
      "episode": "full",
      "tool": "helm_work_report",
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "arguments"
