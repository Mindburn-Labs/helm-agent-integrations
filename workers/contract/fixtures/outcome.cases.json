      "observations": [
        {
          "kind": "ok",
          "stop": false
        },
        {
          "kind": "ok",
          "stop": true,
          "reason": "delegated"
        }
      ],
      "outcome": {
        "state": "input_required",
        "status": {
          "schema": "helm.episode.status.v1",
          "waiting_on": {
            "children": [
              "child-1"
            ]
          }
        }
      }
    }
  },
