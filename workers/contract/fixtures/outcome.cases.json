[
  {
    "name": "report completes",
    "calls": [
      {
        "tool": "github_repository_get",
        "arguments": {
          "repo": "r"
        },
        "result": {
          "is_error": false,
          "structured": {
            "status": "succeeded"
          }
        }
      },
      {
        "tool": "helm_work_report",
        "arguments": {
          "status": "done",
          "summary": "All good.",
          "outputs": [
            {
              "kind": "pr",
              "ref": "1"
            }
          ]
        },
        "result": {
          "is_error": false,
          "structured": {
            "status": "succeeded"
          }
        }
      }
    ],
    "expect": {
      "observations": [
        {
          "kind": "ok",
          "stop": false
        },
        {
          "kind": "ok",
          "stop": true,
          "reason": "reported"
        }
      ],
      "outcome": {
        "state": "completed",
        "status": {
          "schema": "helm.episode.status.v1",
          "report": {
            "status": "done",
            "summary": "All good."
          }
        }
      }
    }
  },
  {
    "name": "escalated structured result parks",
    "calls": [
      {
        "tool": "github_pull_request_create_draft",
        "arguments": {
          "title": "t"
        },
        "result": {
          "is_error": false,
          "structured": {
            "status": "escalated",
            "attempt_id": "att_1"
          }
        }
      }
    ],
    "expect": {
      "observations": [
        {
          "kind": "escalated",
          "stop": true,
          "reason": "escalated"
        }
      ],
      "outcome": {
        "state": "input_required",
        "status": {
          "schema": "helm.episode.status.v1",
          "waiting_on": {
            "attempts": [
              "att_1"
            ]
          }
        }
      }
    }
  },
